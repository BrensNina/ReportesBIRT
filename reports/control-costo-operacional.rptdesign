                <structure><property name="position">18</property><property name="name">iuv</property><property name="dataType">decimal</property></structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[SELECT
    v."placa" AS placa,
    v."codigoPatrimonio" AS "codigoPatrimonio",
    cv."nombre" AS categoria,
    c."mesAnio" AS "mesAnio",
    c."diasUtiles" AS "diasUtiles",
    c."km" AS km,
    c."horas" AS horas,
    c."combustibleGalones" AS "combustibleGalones",
    c."combustibleCosto" AS "combustibleCosto",
    c."lubricanteCosto" AS "lubricanteCosto",
    c."llantasNuevasCosto" AS "llantasNuevasCosto",
    c."llantasReencauchadasCosto" AS "llantasReencauchadasCosto",
    c."gastosLavado" AS "gastosLavado",
    c."gastosViaje" AS "gastosViaje",
    c."cvv" AS cvv,
    c."ckv" AS ckv,
    c."consumo" AS consumo,
    c."iuv" AS iuv
FROM "CostoOperacionMensual" c
JOIN "Vehiculo" v ON v."vehiculoId" = c."vehiculoId"
JOIN "CategoriaVehiculo" cv ON cv."categoriaVehiculoId" = v."categoriaVehiculoId"
WHERE c."mesAnio" = ?
ORDER BY v."placa"]]></xml-property>
            <list-property name="paramBindings">
                <structure>
                    <property name="paramName">mesAnio</property>
                    <expression name="expression" type="javascript">params["pMesAnio"].value</expression>
                </structure>
            </list-property>
